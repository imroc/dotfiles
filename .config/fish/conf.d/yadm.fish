# yu / yi / yug / yig / sy 已改为 ~/.local/bin 下的脚本（任意 shell 可直接调用），
# 此处不再定义 alias，仅保留 fish 专属的命令缩写。
abbr --add yid "yi diff"
abbr --add yud "yu diff"
abbr --add yl "yi pull && yu pull"
abbr --add yil "yi pull"
abbr --add yul "yu pull"
abbr --add yss "yi status && yu status"
abbr --add yis "yi status"
abbr --add yus "yu status"
abbr --add syl "sy pull"
